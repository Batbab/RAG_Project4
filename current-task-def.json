{
    "taskDefinition": {
        "taskDefinitionArn": "arn:aws:ecs:ap-south-1:716147851038:task-definition/doc-parser-app:1",
        "containerDefinitions": [
            {
                "name": "app",
                "image": "716147851038.dkr.ecr.ap-south-1.amazonaws.com/doc-parser/app:latest",
                "cpu": 0,
                "portMappings": [
                    {
                        "containerPort": 8000,
                        "hostPort": 8000,
                        "protocol": "tcp"
                    }
                ],
                "essential": true,
                "environment": [
                    {
                        "name": "EMBEDDING_PROVIDER",
                        "value": "openai"
                    },
                    {
                        "name": "OLLAMA_BASE_URL",
                        "value": "http://localhost:11434"
                    },
                    {
                        "name": "PARSER_BACKEND",
                        "value": "ollama"
                    },
                    {
                        "name": "RERANKER_BACKEND",
                        "value": "openai"
                    },
                    {
                        "name": "QDRANT_URL",
                        "value": "http://localhost:6333"
                    }
                ],
                "mountPoints": [],
                "volumesFrom": [],
