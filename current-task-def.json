                    },
                    {
                        "containerName": "ollama",
                        "condition": "START"
                    }
                ],
                "logConfiguration": {
                    "logDriver": "awslogs",
                    "options": {
                        "awslogs-group": "/ecs/doc-parser-app",
                        "awslogs-region": "ap-south-1",
                        "awslogs-stream-prefix": "app"
                    }
